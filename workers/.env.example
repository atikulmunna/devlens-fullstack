ENV=development
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/devlens
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=devlens_code_chunks
QDRANT_API_KEY=
PARSE_CLONE_TIMEOUT_SECONDS=60
PARSE_MAX_FILES=8000
PARSE_MAX_CHUNKS=20000
PARSE_CHUNK_LINES=120
PARSE_CHUNK_OVERLAP_LINES=20
# Embeddings via OpenRouter (OPENROUTER_API_KEY below). Must match the backend's EMBED_MODEL.
EMBED_MODEL=openai/text-embedding-3-small
EMBED_TIMEOUT_SECONDS=15
EMBED_BATCH_SIZE=32
EMBED_RETRY_ATTEMPTS=3
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_SECONDS=30
WORKER_METRICS_PORT=9101
# OpenRouter: the only AI provider (chunk embeddings + analysis summary LLM). Required to index repos.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_SUMMARY_MODEL=openai/gpt-4o-mini
LLM_SUMMARY_TIMEOUT_SECONDS=15
