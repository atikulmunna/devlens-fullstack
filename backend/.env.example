APP_NAME=DevLens Backend
ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/devlens
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=devlens_code_chunks
QDRANT_API_KEY=

# Embeddings via OpenRouter (OPENROUTER_API_KEY below). Must match the worker's EMBED_MODEL.
EMBED_MODEL=openai/text-embedding-3-small
EMBED_TIMEOUT_SECONDS=15
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FRONTEND_URL=http://localhost:3000
# OpenRouter: the only AI provider (query embeddings + chat LLM). Required for search and chat.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=openai/gpt-4.1-mini
LLM_CHAT_TIMEOUT_SECONDS=15
JWT_SECRET=replace-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
SHARE_TOKEN_TTL_DAYS=7
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_GUEST_PER_WINDOW=10
RATE_LIMIT_AUTH_PER_WINDOW=50
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_LIMIT=50
R2_BUCKET=replace-me
R2_ACCESS_KEY=replace-me
R2_SECRET_KEY=replace-me

