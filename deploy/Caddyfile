# DevLens private-alpha reverse proxy.
#
# DEVLENS_DOMAIN / DEVLENS_TLS_EMAIL / DEVLENS_GATE_SECRET are injected from .env.prod
# via docker-compose. Caddy fetches a real Let's Encrypt certificate automatically for a
# public domain (a free sslip.io hostname derived from the Elastic IP).
#
# Gating: visitors without a valid access cookie see a branded login page (gate.html).
# The page posts the key to the app (frontend-next/app/gate/enter), which checks it and sets
# an httpOnly cookie holding it; with that cookie all traffic is
# proxied to the Next.js frontend (which proxies /api/v1 to the backend internally). The
# cookie gate does not touch the Authorization header, so the app's own JWT bearer auth
# (GitHub login for chat/diff) works unchanged. Share links are the one exception: they open
# without the access key, so a shared overview can be sent to anyone.

{
	email {$DEVLENS_TLS_EMAIL}
}

{$DEVLENS_DOMAIN} {
	encode zstd gzip
	root * /srv

	# Login submission. Caddy matchers cannot read a request body, so the app checks the key: it
	# arrives in a POST body and never lands in access logs or browser history the way a query
	# string would. The app sets the access cookie and sends the browser home (or back, if wrong).
	@gate {
		method POST
		path /gate/enter
	}
	handle @gate {
		reverse_proxy frontend:3000
	}

	# Share links skip the gate: the shared page, its scripts, styles, and fonts, and the share API,
	# which only answers to a signed, unexpired, unrevoked token. The path matcher cleans the path
	# before matching, so a request like /api/v1/share/../repos/... does not count as a share.
	@shared path /share/* /api/v1/share/* /_next/static/*
	handle @shared {
		reverse_proxy frontend:3000
	}

	# No valid access cookie: serve the branded gate page.
	# no-store: the gate is served at every URL, including "/". A cached copy would keep showing
	# after the access cookie is set, so entering the right key would seem to do nothing.
	@ungated not header Cookie *devlens_access={$DEVLENS_GATE_SECRET}*
	handle @ungated {
		header Cache-Control "no-store"
		rewrite * /gate.html
		file_server
	}

	# Gated in: proxy everything to the app (SSE-safe).
	handle {
		reverse_proxy frontend:3000 {
			flush_interval -1
		}
	}
}
